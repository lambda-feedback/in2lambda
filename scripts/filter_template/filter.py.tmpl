    """A Pandoc filter that parses and translates various TeX elements.

    Args:
        elem: The current TeX element being processed. This could be a paragraph,
            ordered list, etc.
        doc: A Pandoc document container - essentially the Pandoc AST.
        set: The Python API that is used to store the result after processing
            the TeX file.
        parsing_answers: Whether an answers-only document is currently being parsed.

    Returns:
        Converted TeX elements for the AST where required
        e.g. replaces math equations so that they are surrounded by $.
    """
    # The @filter decorator has already handled inline maths, images, bold and
    # italic. Only route block-level elements into `set` below.

    # When answers come from a separate file (`in2lambda convert ... -a ...`),
    # this runs a second time with parsing_answers=True: advance to the matching
    # question and attach solutions instead of question text.
    if parsing_answers:
        # if <this element starts a new question's answer>:
        #     set.increment_current_question()
        # if <this element is a solution>:
        #     set.current_question.add_solution(pf.stringify(elem))
        return None

    match type(elem):
        case pf.Para:
            # Question stem or part text, e.g.
            # set.add_question(main_text=elem)
            # set.current_question.add_part_text(elem)
            pass
        case pf.OrderedList:
            # Each item is usually a part, e.g.
            # for item in elem.content:
            #     set.current_question.add_part_text(item)
            pass
        case pf.Div:
            # Solutions are often wrapped in a Div, e.g.
            # set.current_question.add_solution(pf.stringify(elem))
            pass

    return None
